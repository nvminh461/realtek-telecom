# Only needed once the CMS is re-enabled (src/cms/README.md). The current demo build needs no variables.

MONGODB_URI=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Long random string, e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=

# Main domain. The site answers on any domain pointed at it (no redirect); canonical URLs, sitemap and Open Graph
# follow the domain being visited. This one and ALTERNATE_HOSTS are the domains where /admin login works.
NEXT_PUBLIC_SITE_URL=https://realtektelecom.com
# Other domains pointed at the site, comma-separated (needed for /admin login there)
ALTERNATE_HOSTS=www.realtektelecom.com,rtit.asia,www.rtit.asia

# SMTP for contact-form notifications. Without SMTP_HOST, emails are only logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@realtektelecom.com

# Cloudflare Turnstile (contact form). Optional in development.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
